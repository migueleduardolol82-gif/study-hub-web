# Crie esta variável localmente e também no painel da Vercel.
OPENAI_API_KEY=

# Opcionais: altere os modelos sem modificar o código.
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Conta individual, banco e biblioteca privada de documentos.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Integração opcional com Notion (conexão pública OAuth).
# Cadastre a URL de retorno no painel de desenvolvedores do Notion.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/integrations/notion/callback
# Chave base64 de 32 bytes para AES-256-GCM; mantenha somente no servidor.
INTEGRATION_ENCRYPTION_KEY=
